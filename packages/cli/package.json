{
  "name": "@ezekielreu6/firemigrate",
  "version": "0.2.0",
  "description": "CLI-first Firebase to PostgreSQL migration: Firestore, subcollections, Auth users, and Storage metadata",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezekielreu6-bit/firemigrate.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ezekielreu6-bit/firemigrate/issues"
  },
  "homepage": "https://github.com/ezekielreu6-bit/firemigrate#readme",
  "keywords": [
    "firebase",
    "firestore",
    "postgresql",
    "supabase",
    "migration",
    "cli"
  ],
  "bin": {
    "firemigrate": "dist/packages/cli/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2"
  }
}
